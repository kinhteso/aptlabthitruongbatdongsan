# ==============================================================================
# CẤU HÌNH MẪU (.env.example) CHO TRIỂN KHAI DOCKER UBUNTU & LOCAL (PropValue.AI)
# Sao chép thành .env: cp .env.example .env
# ==============================================================================

# --- GitHub Personal Access Token (PAT) phục vụ tải Repo Private & Pull GHCR Image trên Ubuntu ---
# Quyền cần bật cho PAT (Classic): repo, read:packages, write:packages
GITHUB_USER=kinhteso
GITHUB_PAT=ghp_YOUR_GITHUB_PAT_HERE

# --- Cổng Web mặc định (Next.js RWD + PWA mở tại port 3359) ---
WEBAPP_PORT=3359
PORT=3359
API_PORT=8000
NEXTAUTH_URL=http://localhost:3359
NEXT_PUBLIC_APP_URL=http://localhost:3359
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_SECRET=skillvalue_google_oauth_hmac_secret_2026

# --- Google OAuth 2.0 Credentials ---
GOOGLE_CLIENT_ID=1062101941449-3igjpomkk1pmqg3itctcb4go70t5mmom.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- Admin Emails & Mật khẩu Bảo mật Nội bộ Lab (Cơ chế giống LabThitruonglaodongso) ---
# Email đầu tiên login sẽ tự động được gán role ADMIN
ADMIN_EMAIL=phungtuananh3333@gmail.com
# Thêm nhiều admin: dùng ADMIN_EMAILS (comma-separated), ưu tiên hơn ADMIN_EMAIL
ADMIN_EMAILS=phungtuananh3333@gmail.com,phungtuananh2222@gmail.com
ADMIN_PASSWORD=skillvalue_secret_2026

# --- Cơ sở dữ liệu Docker PostgreSQL & Redis ---
POSTGRES_USER=skillvalue
POSTGRES_PASSWORD=skillvalue_secret_2026
POSTGRES_DB=digital_labor_market
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Đường dẫn thư mục trên máy chủ Host để lưu trữ bền vững ngoài Container (Bind Mounts) ---
HOST_POSTGRES_DATA_DIR=./data/postgres
HOST_REDIS_DATA_DIR=./data/redis

# --- Chế độ chạy của container scraper-etl: daemon | once | backfill | auto-heal | audit-portals | mock-verify ---
SCRAPER_MODE=daemon

DATABASE_URL=postgresql://skillvalue:skillvalue_secret_2026@localhost:5432/digital_labor_market
REDIS_URL=redis://localhost:6379/0
